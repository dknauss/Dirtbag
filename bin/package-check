#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

echo "== Dirtbag package check =="

required=(style.css readme.txt license.txt screenshot.png theme.json templates/index.html languages/dirtbag.pot)
for file in "${required[@]}"; do
  [[ -f "$file" ]] || { echo "Missing required file: $file" >&2; exit 1; }
done

echo "Required files OK"

# Accept either form: the directory itself (`/playground export-ignore`, which git
# archive honours and which leaves no empty stub) or the glob (`playground/** ...`).
if ! grep -Eq '^/?playground(/\*\*)?[[:space:]]+export-ignore$' .gitattributes; then
  echo "playground/ must be export-ignored from release archives" >&2
  exit 1
fi

echo "Release archive exclusions OK"

python3 - <<'PY'
from pathlib import Path
import json, struct, re, sys
root = Path('.')

# JSON validation.
json_files = [Path('theme.json'), *sorted(Path('styles').glob('*.json')), *sorted(Path('playground').glob('*.json'))]
for p in json_files:
    json.loads(p.read_text())
print('JSON OK')

# A variation's background feeds the color-scheme/theme-color meta tags
# (dirtbag_head_color_meta). That derivation only accepts a literal hex colour
# and fails closed otherwise, so a variation authored with rgb()/a named colour
# /an unresolved var() would silently drop both tags. Require the literal form.
hex_re = re.compile(r'^#([A-Fa-f0-9]{3}|[A-Fa-f0-9]{6})$')
for p in sorted(Path('styles').glob('*.json')):
    bg = json.loads(p.read_text()).get('styles', {}).get('color', {}).get('background')
    if bg is not None and not hex_re.match(bg):
        raise SystemExit(f'{p}: styles.color.background must be a literal hex colour, got {bg!r}')
print('Style variation backgrounds OK')

# Screenshot dimensions without Pillow.
with open('screenshot.png', 'rb') as f:
    sig = f.read(8)
    if sig != b'\x89PNG\r\n\x1a\n':
        raise SystemExit('screenshot.png is not a PNG')
    length = struct.unpack('>I', f.read(4))[0]
    chunk = f.read(4)
    if chunk != b'IHDR':
        raise SystemExit('screenshot.png missing IHDR')
    width, height = struct.unpack('>II', f.read(8))
    if (width, height) != (1200, 900):
        raise SystemExit(f'screenshot.png must be 1200x900, got {width}x{height}')
print('Screenshot OK')

# Block comment nesting in templates and parts.
comment_re = re.compile(r'<!--\s*(/)?wp:([A-Za-z0-9_\-/]+)(.*?)(/)?\s*-->', re.S)
for p in list(Path('templates').glob('*.html')) + list(Path('parts').glob('*.html')):
    stack = []
    for m in comment_re.finditer(p.read_text()):
        close, name, rest, selfclose = m.group(1), m.group(2), m.group(3), m.group(4)
        if close:
            if not stack or stack[-1] != name:
                raise SystemExit(f'{p}: closing {name} mismatches {stack[-1] if stack else "EMPTY"}')
            stack.pop()
        elif selfclose or rest.rstrip().endswith('/'):
            continue
        else:
            stack.append(name)
    if stack:
        raise SystemExit(f'{p}: unclosed blocks {stack}')
print('Block nesting OK')

# Package hygiene.
for p in root.rglob('*'):
    if '.git' in p.parts:
        continue
    rel = p.as_posix()
    name = p.name
    if any(part in {'.git', '.claude', '.github', '.githooks', '.planning', 'bin', 'docs', 'playground', 'tests', 'node_modules'} for part in p.parts):
        continue
    if p.is_file():
        if name in {'.DS_Store', 'Thumbs.db', 'desktop.ini', 'error_log', 'php.ini', 'web.config', 'favicon.ico'}:
            raise SystemExit(f'Forbidden file: {rel}')
        if p.suffix in {'.zip', '.sql', '.sh', '.xml'}:
            raise SystemExit(f'Forbidden package file type: {rel}')

root_forbidden = {'robots.txt','llms.txt','security.txt','about.txt','colophon.txt','feeds.txt','humans.txt','now.txt','blogroll.txt','blogroll.opml'}
for name in root_forbidden:
    if Path(name).exists():
        raise SystemExit(f'Site-root file must not be in theme package root: {name}')
if Path('.well-known').exists():
    raise SystemExit('.well-known must not be in the theme package root')
print('Package hygiene OK')

# Suspicious frontend/theme code.
scan_files = [*Path('templates').glob('*.html'), *Path('parts').glob('*.html'), *Path('patterns').glob('*.php'), Path('theme.json'), Path('style.css')]
patterns = [r'wp:html', r'<script', r'javascript:', r'\son[a-z]+\s*=']
for p in scan_files:
    text = p.read_text(errors='ignore')
    for pat in patterns:
        if re.search(pat, text, flags=re.I):
            raise SystemExit(f'Suspicious pattern {pat!r} in {p}')
print('Suspicious code scan OK')

# base64_decode is disallowed by WordPress.org Theme Check (obfuscation smell).
# Keep theme/demo PHP clean; data belongs in plain files (e.g. seed-content.json).
for p in [*Path('patterns').glob('*.php'), *Path('playground').glob('*.php')]:
    if 'base64_decode' in p.read_text(errors='ignore'):
        raise SystemExit(f'base64_decode found in {p} (not allowed; use a plain data file)')
print('No base64_decode OK')

# Reconcile guardrails: artifacts a raw Site-Editor export reintroduces and the
# reconcile step is supposed to strip. Fail loudly so they cannot slip back in.
reconcile_artifacts = {
    'core/post-data': 'invalid post-date datetime binding (no-op source)',
    '"theme":"dirtbag"': 'hardcoded theme slug in a template-part ref',
}
# Match real localhost/dev URLs, not the bare word "localhost" in prose.
localhost_url_re = re.compile(r'https?://localhost|localhost:\d')
def reconcile_hits(text):
    hits = [f'{snip!r} — {why}' for snip, why in reconcile_artifacts.items() if snip in text]
    if localhost_url_re.search(text):
        hits.append('absolute localhost/dev URL')
    return hits
for p in scan_files:
    hits = reconcile_hits(p.read_text(errors='ignore'))
    if hits:
        raise SystemExit(f'Reconcile artifact in {p}: {hits[0]}')
print('Reconcile guardrails OK')

# Malformed block delimiters (e.g. <\!-- from shell-mangled authoring).
malformed = '<\\!--'
for p in scan_files:
    if malformed in p.read_text(errors='ignore'):
        raise SystemExit(f'Malformed block delimiter {malformed!r} in {p}')

# Validate the Playground seed blob: the demo content is otherwise unchecked.
def _check_block_nesting(label, text):
    stack = []
    for m in comment_re.finditer(text):
        close, name, rest, selfclose = m.group(1), m.group(2), m.group(3), m.group(4)
        if close:
            if not stack or stack[-1] != name:
                raise SystemExit(f'{label}: closing {name} mismatches {stack[-1] if stack else "EMPTY"}')
            stack.pop()
        elif selfclose or rest.rstrip().endswith('/'):
            continue
        else:
            stack.append(name)
    if stack:
        raise SystemExit(f'{label}: unclosed blocks {stack}')

seed = Path('playground/seed-content.json')
if seed.exists():
    data = json.loads(seed.read_text(encoding='utf-8'))
    seed_terms = {(term.get('taxonomy'), term.get('slug')) for term in data.get('terms', [])}
    seed_attachments = {str(attachment_id): attachment for attachment_id, attachment in data.get('attachments', {}).items()}
    seed_media_files = set()
    for attachment_id, attachment in seed_attachments.items():
        filename = attachment.get('filename')
        if not filename:
            raise SystemExit(f'Seed attachment {attachment_id} missing filename')
        if filename in seed_media_files:
            raise SystemExit(f'Duplicate seed media filename: {filename}')
        seed_media_files.add(filename)
        media_path = Path('playground/media') / filename
        if not media_path.exists():
            raise SystemExit(f'Seed attachment {attachment_id} missing media file: {media_path}')
    for post in data.get('posts', []):
        label = f"seed:{post.get('post_name')}"
        content = post.get('post_content', '')
        if malformed in content:
            raise SystemExit(f'Malformed block delimiter in {label}')
        _check_block_nesting(label, content)
        hits = reconcile_hits(content)
        if hits:
            raise SystemExit(f'Reconcile artifact in {label}: {hits[0]}')
        for slug in post.get('terms', {}).get('category', []):
            if ('category', slug) not in seed_terms:
                raise SystemExit(f'{label}: missing seed category {slug}')
        for slug in post.get('terms', {}).get('post_tag', []):
            if ('post_tag', slug) not in seed_terms:
                raise SystemExit(f'{label}: missing seed tag {slug}')
        thumbnail_id = post.get('thumbnail_attachment_id')
        if thumbnail_id and str(thumbnail_id) not in seed_attachments:
            raise SystemExit(f'{label}: missing thumbnail attachment {thumbnail_id}')
        for attachment_id in re.findall(r'__DB(?:SRC|ID)_(\d+)__', content):
            if attachment_id not in seed_attachments:
                raise SystemExit(f'{label}: missing token attachment {attachment_id}')
    print('Seed content integrity OK')

# Image inventory: fail if wp.org package or Playground demo images drift.
image_exts = {'.png', '.jpg', '.jpeg', '.gif', '.webp', '.svg'}
allowed_theme_images = {
    'screenshot.png',
    'assets/icons/pickup-truck-header.svg',
    'assets/icons/pickup-truck.svg',
}
allowed_playground_images = {
    f"playground/media/{attachment.get('filename')}"
    for attachment in data.get('attachments', {}).values()
} if seed.exists() else set()
actual_theme_images = set()
actual_playground_images = set()
for base in (Path('assets'),):
    if not base.exists():
        continue
    for p in base.rglob('*'):
        if p.is_file() and p.suffix.lower() in image_exts:
            actual_theme_images.add(p.as_posix())
if Path('screenshot.png').exists():
    actual_theme_images.add('screenshot.png')
if Path('playground/media').exists():
    for p in Path('playground/media').glob('*'):
        if p.is_file() and p.suffix.lower() in image_exts:
            actual_playground_images.add(p.as_posix())
if actual_theme_images != allowed_theme_images:
    extra = sorted(actual_theme_images - allowed_theme_images)
    missing = sorted(allowed_theme_images - actual_theme_images)
    raise SystemExit(f'Theme image inventory drift. Extra: {extra}; missing: {missing}')
if actual_playground_images != allowed_playground_images:
    extra = sorted(actual_playground_images - allowed_playground_images)
    missing = sorted(allowed_playground_images - actual_playground_images)
    raise SystemExit(f'Playground image inventory drift. Extra: {extra}; missing: {missing}')
print('Image inventory OK')

# No bundled frontend assets except required style.css and local images/SVGs.
for p in root.rglob('*'):
    if any(part in {'.git', '.claude', '.github', '.githooks', '.planning', 'bin', 'docs', 'playground', 'tests', 'node_modules'} for part in p.parts):
        continue
    if p.is_file() and p.suffix in {'.js', '.woff', '.woff2', '.ttf', '.otf'}:
        raise SystemExit(f'Unexpected bundled frontend asset: {p}')
for p in root.rglob('*.css'):
    if any(part in {'.git', '.claude', '.github', '.githooks', '.planning', 'bin', 'docs', 'playground', 'tests', 'node_modules'} for part in p.parts):
        continue
    if p.as_posix() != 'style.css':
        raise SystemExit(f'Unexpected CSS file: {p}')
print('Asset scan OK')

# i18n: translation calls in theme PHP must use the 'dirtbag' text domain.
# Covers every PHP file the theme ships (functions.php, patterns/) plus the
# export-ignored Playground seeder, whose demo content is still user-facing.
#
# The domain is always the LAST argument, but which position that is varies by
# function, and _n()'s count argument is not a string literal. So: find the call
# name, then split its arguments at paren depth 0 — one regex per shape rots.
# Index of the text-domain argument, 0-based, per WordPress signature.
domain_arg = {
    '__': 1, '_e': 1, 'translate': 1,
    'esc_html__': 1, 'esc_html_e': 1, 'esc_attr__': 1, 'esc_attr_e': 1, 'esc_xml__': 1, 'esc_xml_e': 1,
    '_x': 2, '_ex': 2, 'esc_html_x': 2, 'esc_attr_x': 2, 'esc_xml_x': 2, '_n_noop': 2,
    'translate_with_gettext_context': 2, 'translate_nooped_plural': 2,
    '_n': 3, '_nx_noop': 3,
    '_nx': 4,
}
# Longest name first so _n cannot shadow _n_noop.
call_re = re.compile(r'(?<![A-Za-z0-9_$])(' + '|'.join(sorted(domain_arg, key=len, reverse=True)) + r')\s*\(')
str_re = re.compile(r"""\A'((?:[^'\\]|\\.)*)'\Z|\A"((?:[^"\\]|\\.)*)"\Z""", re.S)
# Only PHP islands are PHP. Pattern files are mostly HTML, where '//' in a URL
# and '#' in a hex colour are not comments. <?= is a translation site too, and
# PHP reads opening tags case-insensitively.
open_tag_re = re.compile(r'<\?(?:php\b|=)', re.I)
# A declaration is not a call, and a namespaced helper that merely shares a name
# (\Dirtbag\translate) is not the WordPress function.
decl_re = re.compile(r'\bfunction\s*$')

def _mask(src, strings=True):
    """Blank comments — and, by default, string interiors — preserving length so
    offsets line up with the original. Call names are found in the fully masked
    text (so a call named in prose is not matched); arguments are parsed from the
    comments-only mask, which drops interleaved comments but keeps literals."""
    out, i, n = list(src), 0, len(src)
    while i < n:
        ch = src[i]
        if ch in '\'"':
            i += 1
            while i < n:
                if src[i] == '\\':
                    if strings:
                        out[i] = ' '
                        if i + 1 < n:
                            out[i + 1] = ' '
                    i += 2
                    continue
                if src[i] == ch:
                    i += 1
                    break
                if strings:
                    out[i] = ' '
                i += 1
            continue
        if src.startswith('/*', i):
            end = src.find('*/', i + 2)
            end = n if end == -1 else end + 2
        elif src.startswith('//', i) or ch == '#':
            end = src.find('\n', i)
            end = n if end == -1 else end
        else:
            i += 1
            continue
        for j in range(i, end):
            if out[j] != '\n':
                out[j] = ' '
        i = end
    return ''.join(out)

def _args(src, open_paren):
    """(arguments, offset just past the closing paren) for the call whose '(' is
    at open_paren, or None if unterminated. Respects nesting and quotes."""
    args, buf, depth, i, n = [], [], 0, open_paren, len(src)
    while i < n:
        ch = src[i]
        if ch in '\'"':
            buf.append(ch)
            i += 1
            while i < n:
                if src[i] == '\\':
                    buf.append(src[i:i + 2])
                    i += 2
                    continue
                buf.append(src[i])
                if src[i] == ch:
                    i += 1
                    break
                i += 1
            continue
        if ch in '([{':
            depth += 1
            if not (depth == 1 and ch == '('):
                buf.append(ch)
        elif ch in ')]}':
            depth -= 1
            if depth == 0:
                args.append(''.join(buf).strip())
                return ([] if args == [''] else args), i + 1
            buf.append(ch)
        elif ch == ',' and depth == 1:
            args.append(''.join(buf).strip())
            buf = []
        else:
            buf.append(ch)
        i += 1
    return None

def _islands(text):
    """(body, absolute offset) for each PHP island. The closing tag is located in
    masked text, so a '?>' inside a string or comment does not end the island
    early — PHP does not treat those as closing tags either."""
    found, pos = [], 0
    while True:
        m = open_tag_re.search(text, pos)
        if not m:
            return found
        rest = text[m.end():]
        close = re.search(r'\?>', _mask(rest))
        found.append((rest[:close.start()] if close else rest, m.end()))
        pos = m.end() + (close.end() if close else len(rest))

def i18n_violations(text):
    """Return (line, call source, reason) for each bad text domain in `text`."""
    hits = []
    for src, base in _islands(text):
        masked = _mask(src)                  # find call names
        code = _mask(src, strings=False)     # parse arguments
        for m in call_re.finditer(masked):
            before = code[:m.start()].rstrip()
            if before.endswith(('->', '::', '\\')):
                continue  # method, or a namespaced function sharing the name
            if decl_re.search(before):
                continue  # a declaration, not a call
            parsed = _args(code, m.end() - 1)
            if parsed is None:
                continue
            args, end = parsed
            idx = domain_arg[m.group(1)]
            line = text.count('\n', 0, base + m.start()) + 1
            call = ' '.join(code[m.start():end].split())
            if len(args) <= idx:
                hits.append((line, call, 'text domain argument is missing'))
                continue
            literal = str_re.match(args[idx])
            if not literal:
                hits.append((line, call, f'text domain must be a literal string, got {args[idx]!r}'))
            elif (literal.group(1) or literal.group(2)) != 'dirtbag':
                hits.append((line, call, f"text domain must be 'dirtbag', got {args[idx]!r}"))
    return hits

# Self-test: pins the matcher so it cannot silently stop catching things.
for _src in ["<?php __( 'x', 'wrong' );", "<?php __( 'x' );", '<?php __( "x", "wrong" );',
             "<?php _e( 'x', 'wrong' );", "<?php esc_html__( 'x', 'wrong' );",
             "<?php _x( 'x', 'ctx', 'wrong' );", "<?php _x( 'x', 'ctx' );",
             "<?php esc_html_x( 'x', 'ctx', 'wrong' );", "<?php _ex( 'x', 'ctx', 'wrong' );",
             "<?php _n( 'a', 'b', $n, 'wrong' );", "<?php _n( 'a', 'b', $n );",
             "<?php _nx( 'a', 'b', $n, 'ctx', 'wrong' );", "<?php _n_noop( 'a', 'b' );",
             "<?php __( 'x', DIRTBAG );", "<?php echo sprintf( __( 'x %s', 'wrong' ), $y );",
             "<?= esc_html__( 'x', 'wrong' ) ?>", "<?= _x( 'x', 'ctx', 'wrong' ) ?>",
             "<?php translate( 'x', 'wrong' );",
             "<?php translate_with_gettext_context( 'x', 'ctx', 'wrong' );",
             "<?php translate_nooped_plural( $noop, 2, 'wrong' );",
             "<?php _n( 'a', 'b', $n, /* why */ 'wrong' );",
             "<?PHP __( 'x', 'wrong' );", "<?Php _x( 'x', 'ctx', 'wrong' );",
             "<?php $s = '?>'; __( 'x', 'wrong' );",
             "<?php /* ?> */ __( 'x', 'wrong' );"]:
    if not i18n_violations(_src):
        raise SystemExit(f'i18n self-test: matcher failed to flag {_src!r}')
for _src in ["<?php __( 'x', 'dirtbag' );", '<?php __( "x", "dirtbag" );',
             "<?php _x( 'x', 'ctx', 'dirtbag' );", "<?php _n( 'a', 'b', $n, 'dirtbag' );",
             "<?php _nx( 'a', 'b', $n, 'ctx', 'dirtbag' );", "<?php _n_noop( 'a', 'b', 'dirtbag' );",
             "<?php echo sprintf( __( 'x %s', 'dirtbag' ), $y );",
             "<?php __( 'it\\'s', 'dirtbag' );",
             "<?php $s = 'mentions _x( foo ) in a string'; // and _e( 'x', 'wrong' ) in a comment",
             "<?php /* _e( 'x', 'wrong' ) */ my__( 'x', 'wrong' ); $o->__( 'x', 'wrong' );",
             "<a href='https://example.com/'>not php</a>",
             "<?= esc_html__( 'x', 'dirtbag' ) ?>",
             "<?php translate( 'x', 'dirtbag' );",
             "<?php translate_with_gettext_context( 'x', 'ctx', 'dirtbag' );",
             "<?php _n( 'a', 'b', $n, /* item count */ 'dirtbag' );",
             "<?php _n( 'a', 'b', $n, // item count\n 'dirtbag' );",
             "<?php _x( 'x', /* ctx */ 'ctx', 'dirtbag' );",
             "<?php namespace Dirtbag; function translate( $value, $locale ) { return $value; }",
             "<?php function __( $text, $domain ) {}",
             "<?php echo \\Dirtbag\\translate( $value, $locale );",
             "<?php $html = '?> not a close'; __( 'x', 'dirtbag' );"]:
    _hits = i18n_violations(_src)
    if _hits:
        raise SystemExit(f'i18n self-test: matcher wrongly flagged {_src!r} ({_hits[0][2]})')

# Discover every PHP file rather than naming locations: a future inc/ or
# template-tags.php must not silently escape the check the way functions.php did.
# playground/ is deliberately included — it does not ship, but its seed content
# is user-facing. Only tooling/dev directories are skipped.
i18n_skip_dirs = {'.git', '.github', '.githooks', '.planning', 'bin', 'docs', 'tests', 'node_modules'}
php_files = sorted(p for p in root.rglob('*.php')
                   if not any(part in i18n_skip_dirs for part in p.parts))
if not php_files:
    raise SystemExit('i18n: found no PHP files to check — discovery is broken')
for p in php_files:
    for line, call, reason in i18n_violations(p.read_text()):
        raise SystemExit(f'i18n: {p}:{line}: {reason} in {call!r}')
print('i18n text domain OK')
PY

for file in functions.php patterns/*.php playground/*.php; do
  [[ -f "$file" ]] || continue
  php -l "$file" >/dev/null
done

echo "PHP syntax OK"

# Unit tests for the theme's one island of pure logic. Dependency-free, so it
# runs in the same gate rather than needing the Playwright harness. Skipped when
# tests/ is absent — it is export-ignored, so the release zip has no copy.
if [[ -f tests/php/color-scheme-test.php ]]; then
  php tests/php/color-scheme-test.php
fi

echo "All package checks passed."
