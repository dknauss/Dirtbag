{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "wp": "7.0",
    "php": "8.2"
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": true,
        "WP_DEBUG_LOG": true
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/dknauss/dirtbag",
        "ref": "__REF__",
        "refType": "commit",
        "path": "/"
      },
      "options": {
        "activate": true,
        "targetFolderName": "dirtbag"
      },
      "ifAlreadyInstalled": "overwrite"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; if ( get_stylesheet() !== 'dirtbag' ) { switch_theme( 'dirtbag' ); } require '/wordpress/wp-content/themes/dirtbag/playground/seed-content.php'; dirtbag_playground_seed_content();"
    }
  ]
}
